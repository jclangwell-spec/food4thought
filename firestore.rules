rules_version = '2';

// Phase 1 rules. Everyone signed in can read; people can only write their
// own profile. Tightened further in phase 1, step 7.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();

      // A new profile starts with zero counts and claims its handle in the
      // same write.
      allow create: if isMe(uid)
        && request.resource.data.reviewCount == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;

      // Handles can't be changed yet.
      allow update: if isMe(uid)
        && request.resource.data.handle == resource.data.handle;
    }

    match /handles/{handle} {
      allow read: if signedIn();

      // Claimed once, by the profile that uses it, and never reassigned.
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{1,30}$')
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;
    }
  }
}
